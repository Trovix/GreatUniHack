{
  "name": "lecture-access",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "tsx apps/api/main.ts",
    "fixture": "tsx scripts/fixture-server.ts",
    "build": "vite build && esbuild apps/extension/src/worker.ts --bundle --format=esm --outfile=dist/extension/worker.js && esbuild apps/extension/src/capture.ts --bundle --format=iife --outfile=dist/extension/capture.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.cache/playwright playwright test",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "verify:live": "tsx scripts/live-verify.ts",
    "verify:offline": "tsx scripts/verify-offline.ts",
    "verify:speech": "tsx scripts/verify-speech.ts"
  },
  "dependencies": {
    "music-metadata": "11.16.1",
    "pdfjs-dist": "5.4.296",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.65.0",
    "@types/chrome": "0.1.27",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "esbuild": "0.25.12",
    "node": "22.21.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
